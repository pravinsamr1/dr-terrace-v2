# Copy this file to ".env" and fill in the values. ".env" is ignored by git; never commit real tokens.
# Restart the dev server (npx expo start -c) or rebuild the app after changing these.

# --- WhatsApp Business (Cloud API) ---------------------------------------------------------------
# Leave the token or the phone number ID empty to switch the feature off: the "Send via WhatsApp"
# buttons then open the normal share sheet.
#
# NOTE: EXPO_PUBLIC_* values are built into the app and can be read from the APK.
EXPO_PUBLIC_WHATSAPP_ACCESS_TOKEN=
EXPO_PUBLIC_WHATSAPP_PHONE_NUMBER_ID=

# Graph API version shown in your Meta app dashboard
EXPO_PUBLIC_WHATSAPP_API_VERSION=v23.0

# Language the templates were approved in (en, en_US, en_GB, ...)
EXPO_PUBLIC_WHATSAPP_TEMPLATE_LANGUAGE=en

# Approved template names. Each needs a DOCUMENT header and these body variables:
#   quotation: {{1}} customer name, {{2}} quotation number
#   receipt:   {{1}} customer name, {{2}} document name, {{3}} document number
#   warranty:  {{1}} customer name
EXPO_PUBLIC_WHATSAPP_TEMPLATE_QUOTATION=quotation_document
EXPO_PUBLIC_WHATSAPP_TEMPLATE_RECEIPT=receipt_document
EXPO_PUBLIC_WHATSAPP_TEMPLATE_WARRANTY=warranty_document

# Only used by "npm run check:whatsapp" to verify your templates (not built into the app).
# Meta > WhatsApp > API Setup > "WhatsApp Business Account ID"
WHATSAPP_BUSINESS_ACCOUNT_ID=
